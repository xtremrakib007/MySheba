{
  "expo": {
    "name": "MySheba",
    "slug": "rakib",
    "version": "5.4.1.13",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5f0bbeb3-e2d9-4a46-af9f-66379fada1c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 4000
    },
    "newArchEnabled": false,
    "scheme": "mysheba",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2FAF7"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.satulink.mysheba",
      "googleServicesFile": "./google-services.json",
      "versionCode": 48,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mysheba.top"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Allow MySheba to access your camera for KYC identity verification and video calls."
      }
    },
    "notification": {
      "color": "#1A73E8",
      "androidMode": "default",
      "androidCollapsedTitle": "MySheba"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MySheba to access your photos so you can upload a top-up bank receipt."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A73E8",
          "sounds": [
            "./assets/sounds/ringtone.mp3",
            "./assets/sounds/soft.mp3"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MySheba to access your contacts so it can show which of your saved numbers are on MySheba, like WhatsApp does."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp",
            "fb",
            "instagram",
            "instagram-stories",
            "twitter",
            "linkedin"
          ],
          "android": [
            "com.whatsapp",
            "com.facebook.katana",
            "com.instagram.android",
            "com.twitter.android",
            "com.linkedin.android"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MySheba to access your camera for KYC identity verification and QR scanning."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withRemoveUnusedPermissions",
      "./plugins/withFixNotificationColorMerge"
    ],
    "extra": {
      "eas": {
        "projectId": "5f0bbeb3-e2d9-4a46-af9f-66379fada1c8"
      }
    },
    "owner": "xtremrakib5"
  }
}
