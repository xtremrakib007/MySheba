rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---- topup-receipts/{uid}/{fileName}: bank transfer/deposit receipts
    // uploaded from the Top-Up screen (see src/firebase/topupService.js).
    // Only the owner can upload into their own folder. Read is owner-or-
    // admin only, mirroring firestore.rules' topups/{id} read rule exactly
    // (admin reviews the queue - dealers don't) - AdminHomeScreen is the
    // only screen that ever loads another user's receiptUrl, so this
    // matches real usage, not just theory.
    match /topup-receipts/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- remittance-passports/{uid}/{fileName}: sender's passport photo,
    // captured or uploaded on the Remittance wizard's Sender Details step
    // (see src/firebase/receiverService.js uploadPassport). Read is
    // owner-or-staff (TransactionDetailModal is the only screen that shows
    // another user's passportUrl, and it's shown to whichever staff member
    // can already see that transaction) - never any signed-in user, unlike
    // before, since a passport photo is the most sensitive file this app
    // stores. ----
    match /remittance-passports/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
      );
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- verification-documents/{uid}/{fileName}: the ID document photo
    // submitted for the "Verified" seller badge (Phase 3, see
    // src/firebase/verificationService.js + mediaUpload.uploadVerificationDocument).
    // Mirrors remittance-passports above exactly - an ID document is just
    // as sensitive as a passport photo, so read stays owner-or-staff only,
    // never any signed-in user. Only the owner can write into their own
    // folder. ----
    match /verification-documents/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- passport-copies/{uid}/{fileName}: the passport copy uploaded from
    // the Profile screen's own "Upload passport copy" field (see
    // src/firebase/mediaUpload.js uploadPassportCopy). Unlike
    // remittance-passports/verification-documents above, read is
    // owner-or-superadmin ONLY - no dealer/dealer/admin - since this
    // isn't tied to any transaction a dealer/admin needs to review, it's
    // just the user's own KYC document sitting on their profile. Accepts
    // image OR pdf, unlike avatars below which is image-only. Only the
    // owner can write into their own folder; no delete, matching every
    // other document path in this file. ----
    match /passport-copies/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if false;
    }

    // ---- avatars/{uid}/{fileName}: profile photo uploaded from the Profile
    // screen (see src/firebase/mediaUpload.js uploadAvatar). Read stays
    // open to any signed-in user - unlike the receipt/passport files above,
    // nothing here is sensitive, and the app already has no cross-user
    // avatar display today, so there's nothing to accidentally break
    // either way. Only the owner can write into their own folder. ----
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- business-logos/{uid}/{fileName}: Business Profile logo upload
    // (see src/firebase/mediaUpload.js uploadBusinessLogo, used from the
    // Profile screen's Business Profile section once an admin has granted
    // businessProfiles/{uid}.isBusinessProfile). Same shape as avatars/
    // above - public read, owner-only write, no delete. ----
    match /business-logos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- chat-media/{chatType}/{threadId}/{fileName}: photos/videos/
    // documents/voice notes attached in a chat thread. Split by chatType
    // (see mediaUpload.js's uploadChatMedia) so each match block can look
    // up the right Firestore collection and enforce the SAME membership
    // rule that collection already uses for its messages - previously this
    // was one path for every chat type with no membership check at all
    // (any signed-in user who had/guessed a URL could read any chat's
    // media); now each type mirrors its own firestore.rules thread rule
    // exactly. Capped at 50MB per attachment (covers a short voice/video
    // clip; large video files should be trimmed client-side before
    // upload). ----

    // 'support': chats/{uid} - customer <-> Support, uid is always the
    // customer's own uid. Same rule as chats/{chatId}: the customer
    // themselves, or any staff member (a shared queue, not dealer-scoped).
    match /chat-media/support/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
      ) && request.resource.size < 50 * 1024 * 1024;
      allow delete: if false;
    }

    // 'direct': directChats/{chatId} - only the two participants on that
    // thread doc, same as directChats/{chatId}'s own rule.
    match /chat-media/direct/{chatId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid in firestore.get(/databases/(default)/documents/directChats/$(chatId)).data.participants;
      allow write: if request.auth != null
                   && request.auth.uid in firestore.get(/databases/(default)/documents/directChats/$(chatId)).data.participants
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if false;
    }

    // 'group': groupChats/{groupId} - only current members, same as
    // groupChats/{groupId}'s own rule.
    match /chat-media/group/{groupId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid in firestore.get(/databases/(default)/documents/groupChats/$(groupId)).data.memberUids;
      allow write: if request.auth != null
                   && request.auth.uid in firestore.get(/databases/(default)/documents/groupChats/$(groupId)).data.memberUids
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if false;
    }

    // 'room': roomChats/{roomId} - only current members, same as
    // roomChats/{roomId}/messages' own rule (room metadata is browsable by
    // any signed-in user, but message media stays member-only).
    match /chat-media/room/{roomId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid in firestore.get(/databases/(default)/documents/roomChats/$(roomId)).data.memberUids;
      allow write: if request.auth != null
                   && request.auth.uid in firestore.get(/databases/(default)/documents/roomChats/$(roomId)).data.memberUids
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if false;
    }

    // ---- banner-images/{fileName}: optional photo background for a home
    // page banner slide, uploaded from Admin > Banners (see
    // src/firebase/bannerService.js uploadBannerImage). Only admin/superadmin
    // may write - mirrors firestore.rules' isAdmin() check via a Firestore
    // lookup, since Storage rules can't read custom claims directly here.
    // Read is open to any signed-in user since it backs the public home
    // page slider every customer sees. ----
    match /banner-images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- payment-settings/{fileName}: the DuitNow QR code image a
    // superadmin uploads from Admin > Payments (see
    // src/firebase/mediaUpload.js uploadPaymentQr). Only superadmin may
    // write - mirrors banner-images above but locked to superadmin only,
    // matching firestore.rules' settings/paymentMethods write rule. Read
    // is open to any signed-in user since the customer Top-Up screen shows
    // this QR to everyone paying via DuitNow. ----
    match /payment-settings/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- order-receipts/{txId}/{fileName}: unified Phase 10 receipt ----
    match /order-receipts/{txId}/{fileName} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/transactions/$(txId)).data.customerId == request.auth.uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin', 'reseller']
      );
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin', 'reseller']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- remittance-receipts/{txId}/{fileName}: dealer/admin's
    // proof-of-transfer photo, uploaded when marking a Remittance order
    // complete (see src/firebase/mediaUpload.js uploadRemittanceReceipt).
    // Only staff (dealer/dealer/admin/superadmin) may write - the
    // customer never uploads this themselves, unlike topup-receipts above.
    // Read is the customer who owns that transaction, or any staff member -
    // looked up from the linked transactions/{txId} doc, same owner check
    // firestore.rules already does for reading the transaction itself. ----
    match /remittance-receipts/{txId}/{fileName} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/transactions/$(txId)).data.customerId == request.auth.uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
      );
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- flight-tickets/{inquiryId}/{fileName}: admin's issued
    // ticket/e-ticket, uploaded when closing a flight inquiry (see
    // src/firebase/mediaUpload.js uploadFlightTicket). Admin-only write
    // (flight inquiries are admin's queue, not dealer's - see
    // AdminHomeScreen). Allows PDF as well as image, since e-tickets are
    // commonly issued as PDF. Read is the customer who filed that inquiry,
    // or any staff member - same owner check firestore.rules already does
    // for reading the inquiry itself. ----
    match /flight-tickets/{inquiryId}/{fileName} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/inquiries/$(inquiryId)).data.customerId == request.auth.uid
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['dealer', 'admin', 'superadmin']
      );
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if false;
    }

    // ---- marketplace-images/{listingId}/{fileName}: Buy & Sell listing
    // photos (see src/firebase/mediaUpload.js uploadMarketplaceImage).
    // Readable by anyone signed in (public classifieds board). Write is
    // restricted to that listing's seller, checked by looking up the
    // listing doc itself - which means the listing must already exist
    // before its first photo upload (marketplaceService.createListing
    // runs first, then images are uploaded, then the listing doc's
    // `images[]` is updated with the resulting URLs). ----
    match /marketplace-images/{listingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/marketplaceListings/$(listingId)).data.sellerId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- accommodation-images/{propertyId}/{fileName}: Accommodation
    // property photos (see src/firebase/mediaUpload.js
    // uploadPropertyImage). Mirrors marketplace-images above - readable by
    // anyone signed in, write restricted to that property's owner, checked
    // by looking up the property doc itself (must already exist before its
    // first photo upload - accommodationService.createProperty runs first,
    // then images are uploaded, then the property doc's `images[]` is
    // updated with the resulting URLs). ----
    match /accommodation-images/{propertyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- service-provider-images/{providerId}/{fileName}: Local Services
    // provider profile photo (Phase 2 of the Marketplace PRD, section 8;
    // see src/firebase/mediaUpload.js uploadServiceProviderPhoto). Mirrors
    // accommodation-images above - readable by anyone signed in, write
    // restricted to that provider profile's owner, checked by looking up
    // the provider doc itself (must already exist before its photo upload
    // - serviceProviderService.createProvider runs first, then the photo
    // is uploaded, then the provider doc's `photo` is set to the
    // resulting URL). Only one photo per provider (unlike the images[]
    // gallery the other two modules use), but the path still keys off
    // providerId + a generated fileName the same way, so this rule needs
    // no changes if a gallery is ever added later. ----
    match /service-provider-images/{providerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/serviceProviders/$(providerId)).data.ownerId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- community-images/{postId}/{fileName}: Community post photos
    // (Jobs/Events/Lost & Found/Emergency/News - see
    // src/firebase/mediaUpload.js uploadCommunityImage). Mirrors
    // marketplace-images above - readable by anyone signed in, write
    // restricted to that post's author, checked by looking up the post
    // doc itself (must already exist before its first photo upload -
    // communityService.createPost runs first, then images are uploaded,
    // then the post doc's `images[]` is updated with the resulting
    // URLs). ----
    match /community-images/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- social-images/{postId}/{fileName}: Social Feed post photos
    // (Next Update PRD §3 - see src/firebase/mediaUpload.js
    // uploadSocialPostImage). Exact mirror of community-images above. ----
    match /social-images/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/socialPosts/$(postId)).data.authorId == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // ---- my-documents/{uid}/{documentId}/{fileName}: private per-user
    // document vault files (passport, visa, work permit, etc.) - see
    // src/firebase/documentStorageService.js. Owner-only read/write/
    // delete, unlike passport-copies/verification-documents above which
    // allow delete: false - this module actively replaces and deletes
    // files (DocumentDetailsScreen's "Replace Document" / "Delete
    // Document"), so delete has to be allowed for the owner here. Accepts
    // image or PDF up to 15MB, matching MAX_FILE_SIZE_BYTES /
    // ALLOWED_MIME_TYPES in src/data/documentConstants.js - keep both in
    // sync if those limits ever change. ----
    match /my-documents/{uid}/{documentId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- salary-payslips/{uid}/{recordId}/{fileName}: Salary & OT
    // module's payslip uploads (PRD section 16) - see
    // src/firebase/salaryStorageService.js. Same shape as my-documents
    // above (owner-only read/write/delete, image or PDF up to 15MB,
    // matching MAX_FILE_SIZE_BYTES/ALLOWED_MIME_TYPES in
    // salaryStorageService.js - keep both in sync if those limits ever
    // change), just under a different top-level path since this module's
    // Firestore data lives under users/{uid}/salaryRecords rather than a
    // flat myDocuments collection - see the Salary & OT note in
    // firestore.rules for why. recordId is the 'YYYY-MM' salary record id
    // (salaryRecordService.recordId()), not a documentId. ----
    match /salary-payslips/{uid}/{recordId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- PHASE 1 - Advertisement System (foundation only - see
    // src/constants/adCollections.ts's AD_STORAGE_PATHS, which these four
    // paths match exactly). No file is uploaded to any of these paths by
    // this phase - src/firebase/adService.js's uploadAdCreative is a
    // documented stub, not a working uploader yet. These rules exist now
    // so the path structure the brief asked for is real and enforced the
    // moment a later phase does implement uploads, not bolted on after.
    //
    // Write is superadmin-only across all four - stricter than
    // banner-images/payment-settings above (admin/superadmin and
    // superadmin-only respectively), matching firestore.rules' ad
    // collections, which are all superadmin-only write for the same
    // reason: ad configuration is explicitly Super Admin-only per the
    // brief. ads/advertisers read is isAdmin()-scoped (an advertiser
    // logo/document isn't customer-facing, no UI shows it to a regular
    // user), the other three are open to any signed-in user since a
    // later phase renders those creatives on every role's screens. ----
    match /ads/banners/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
    match /ads/native/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
    match /ads/interstitial/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
    match /ads/advertisers/{fileName} {
      allow read: if request.auth != null
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
