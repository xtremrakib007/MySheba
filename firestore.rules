rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Server-side truth for the caller's own "Business Profile" badge (see
    // businessProfiles/{uid} below) - used the same way myProfile().verified
    // is used to check sellerVerified on create, so a client can't just
    // write sellerIsBusiness/ownerIsBusiness: true for itself. exists()
    // first because most users have never been granted one, and get() on a
    // missing doc throws rather than returning a default.
    function myIsBusiness() {
      return signedIn()
        && exists(/databases/$(database)/documents/businessProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/businessProfiles/$(request.auth.uid)).data.get('isBusinessProfile', false);
    }

    function myRole() {
      return signedIn() ? myProfile().role : null;
    }

    function isStaff() {
      return myRole() in ['dealer', 'reseller', 'admin', 'superadmin'];
    }

    function isAdmin() {
      return myRole() in ['admin', 'superadmin'];
    }

    function isSuperadmin() {
      return myRole() == 'superadmin';
    }

    // Marketplace-scoped ban (Marketplace Admin Panel > Ban users - see
    // functions/userManagement.js's 'setMarketplaceBan' action). Only
    // blocks new Buy & Sell / Accommodation / Room Sharing posts; it does
    // not touch login or any other part of the app.
    function isMarketplaceBanned() {
      return signedIn() && myProfile().marketplaceBanned == true;
    }

    function isDealerTier() {
      return myRole() == 'dealer';
    }

    // A reseller is its own tier, parallel to isDealerTier() - a customer's
    // resellerId (set at registration via a reseller code, or by admin's
    // 'setReseller' action) scopes which reseller can see/forward that
    // customer's dealer-queue orders. Unlike dealer/dealer, a reseller
    // has no sub-tier and no shared "scope" helper - resellerId always
    // points straight at the reseller's own uid.
    function isReseller() {
      return myRole() == 'reseller';
    }

    // Phase 10 service-tier split: Dealer and Reseller no longer share one
    // undifferentiated queue - each can only accept/complete the specific
    // transaction services their tier owns. Admin/superadmin are exempt
    // (universal override, same as every other admin-vs-tier check in this
    // file) so support/ops can always step in on any order regardless of
    // service. See DealerHomeScreen.js/ResellerHomeScreen.js, which filter
    // the shared broadcast stream client-side to match this same split -
    // this function is the actual enforcement, that's just UX.
    function canHandleTransaction(txnservice) {
      return isAdmin()
        || (isDealerTier() && txnservice == 'Mobile Banking')
        || (isReseller() && txnservice in ['Recharge', 'Internet', 'Remittance']);
    }

    // Direct-chat blocking (Marketplace PRD section 11 "Security: Block
    // user"). directChatId() always names a thread's doc "<uidA>_<uidB>"
    // with the two uids sorted (see directChatService.js) - so the other
    // participant can be read straight off chatId with no extra doc
    // lookup. blockedUids lives on the blocker's own users/{uid} doc (a
    // normal, non-frozen field - see the users/{uid} update rule above),
    // so blocking is a self-service write; it's enforced here by refusing
    // to create a message when the intended recipient has the sender on
    // their blockedUids list.
    function otherDirectChatUid(chatId, uid) {
      return chatId.split('_')[0] == uid ? chatId.split('_')[1] : chatId.split('_')[0];
    }

    function isBlockedByRecipient(chatId, senderUid) {
      return senderUid in get(/databases/$(database)/documents/users/$(otherDirectChatUid(chatId, senderUid))).data.get('blockedUids', []);
    }

    // The dealer a dealer-tier caller's customer pool is scoped to: a
    // dealer's own uid, or (for a dealer) the parent dealer's uid off
    // their own profile. Only meaningful when isDealerTier() is true.
    function myDealerScope() {
      return request.auth.uid;
    }

    // All four dealer-queue services debit wallet points at order creation.
    // The Cloud Functions are the only create path for these orders.
    function serviceIsChargeable(data) {
      return data['service'] in ['Recharge', 'Internet', 'Mobile Banking', 'Remittance'];
    }

    // ---- users/{uid}: profile + role ----
    match /users/{uid} {
      // A user can read their own profile. Admin/superadmin can read
      // anyone. A dealer/dealer can only read customers assigned to
      // their own dealer pool - never another dealer's customers - so
      // customer lists never mix across dealers.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isDealerTier() && resource.data.dealerId == myDealerScope())
        || (isReseller() && resource.data.get('resellerId', null) == request.auth.uid)
      );
      // Self-registration always writes role: 'customer' - never anything
      // more privileged. Role changes and staff-created accounts go
      // through the manageUser Cloud Function (functions/userManagement.js),
      // which uses the Admin SDK and re-checks the caller's role
      // server-side - never through this client rule.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'customer';
      // Owner can update their own doc (role can't change this way).
      // Admin/superadmin can update anyone; a dealer/dealer can only
      // update their own customers' docs. Several fields are frozen on
      // EVERY client write, regardless of who's writing - role (as
      // before), plus walletBalance, dealerId, userId, and createdBy.
      // Those four used to only be "walletBalance can't go negative",
      // which meant any signed-in user could set their OWN walletBalance
      // to any non-negative number with a single direct write, completely
      // bypassing every top-up/transfer/charge flow's logic (those flows
      // computed a new balance in client JS and then just wrote it - a
      // check, not an enforcement). All wallet-affecting operations now go
      // through Cloud Functions (functions/walletService.js) using the
      // Admin SDK, which bypasses this rule entirely - so freezing the
      // field here for the client is what actually makes the "server
      // enforces it" story true, not just documented. dealerId/resellerId/
      // userId are frozen the same way since manageUser
      // (functions/userManagement.js) already owns changing those - the
      // client update path here was dead code for them, this just makes
      // that explicit and enforced. A reseller only ever gets read access
      // to their own pool (see the read rule above) - never write, so
      // there's no reseller branch needed down in the update condition
      // below.
      // Same freeze applies to the four charge-tracking maps chargeWallet
      // (functions/walletService.js) uses to decide "already paid, still
      // in the free window" - lastAccessCharge, webviewSubmitted,
      // lastPaymentCharge, moduleSubscription. Without this, a user could
      // skip paying entirely by writing a recent timestamp onto their own
      // doc directly, then relying on chargeWallet reading that forged
      // timestamp back as proof of a legitimate charge.
      //
      // Every comparison below uses .get(field, default) rather than dot
      // access - dot access throws (denying the whole request) if the
      // field is simply absent from the doc, and createdBy in particular
      // IS absent on every self-registered/Google customer profile
      // (registerWithDealerCode / ensureGoogleProfile never set it - only
      // staff-created accounts via manageUser do). That meant any
      // self-registered customer's own profile edit (name, mobile,
      // email, passport, address, avatar - see ProfileScreen.js) failed
      // with "missing or insufficient permissions" on every save, since
      // this whole allow-update block evaluated to an error before it
      // ever reached the actual uid/role check below.
      allow update: if signedIn() && request.resource.data.get('role', null) == resource.data.get('role', null)
                    && request.resource.data.get('walletBalance', null) == resource.data.get('walletBalance', null)
                    && request.resource.data.get('dealerId', null) == resource.data.get('dealerId', null)
                    && request.resource.data.get('resellerId', null) == resource.data.get('resellerId', null)
                    && request.resource.data.get('userId', null) == resource.data.get('userId', null)
                    && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                    && request.resource.data.get('verified', false) == resource.data.get('verified', false)
                    && request.resource.data.get('lastAccessCharge', {}) == resource.data.get('lastAccessCharge', {})
                    && request.resource.data.get('webviewSubmitted', {}) == resource.data.get('webviewSubmitted', {})
                    && request.resource.data.get('lastPaymentCharge', {}) == resource.data.get('lastPaymentCharge', {})
                    && request.resource.data.get('moduleSubscription', {}) == resource.data.get('moduleSubscription', {})
                    // suspended is set only by manageUser's 'suspend' action (Admin SDK,
                    // bypasses this rule) - frozen here so a client can never self-write
                    // their own way out of a suspension.
                    && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
                    // securityPinSet is only ever flipped by setupSecurityPin/resetSecurityPin
                    // (functions/securityPinService.js, Admin SDK) - frozen the same way as
                    // 'verified' above so a client can't fake having a PIN set (which would
                    // skip straight to SecurityPinGate's verify mode against a PIN that was
                    // never actually stored) or fake NOT having one (forcing a fresh setup
                    // that silently overwrites - functions/securityPinService.js already
                    // guards this server-side too, this just stops the client-visible flag
                    // from ever lying about it).
                    && request.resource.data.get('securityPinSet', false) == resource.data.get('securityPinSet', false)
                    // activeSessionId/activeDeviceId/pendingDeviceApproval are the
                    // single-device-login state (functions/deviceSessionService.js,
                    // Admin SDK, bypasses this rule) - frozen the same way so a
                    // client can never self-approve a device switch or erase another
                    // device's active session with a direct write.
                    && request.resource.data.get('activeSessionId', null) == resource.data.get('activeSessionId', null)
                    && request.resource.data.get('activeDeviceId', null) == resource.data.get('activeDeviceId', null)
                    && request.resource.data.get('pendingDeviceApproval', null) == resource.data.get('pendingDeviceApproval', null)
                    // trustedDevices is the admin/superadmin skip-OTP device
                    // list (functions/deviceSessionService.js, Admin SDK via
                    // checkDeviceSession/listTrustedDevices/
                    // revokeTrustedDevice, bypasses this rule) - frozen the
                    // same way so a client can never self-grant a device
                    // trust (and skip the OTP challenge) with a direct write.
                    && request.resource.data.get('trustedDevices', {}) == resource.data.get('trustedDevices', {})
                    // knownIps is the IP-anomaly-signal state
                    // (functions/anomalyService.js, Admin SDK, bypasses this
                    // rule) - frozen the same way as the device-session
                    // fields above, so an account that's been taken over
                    // can't be used to erase or forge its own IP history and
                    // hide the takeover from the anomaly signal.
                    && request.resource.data.get('knownIps', []) == resource.data.get('knownIps', [])
                    // tier/tierLabel/tierPoints/level/levelPoints are the
                    // Tier/Level progression state (functions/
                    // progressionService.js's incrementTierPoints/
                    // incrementLevelPoints, called only from the
                    // onTransactionUpdated/onInquiryUpdated/
                    // onChatMessageCreated/onGamePointsLedgerCreated
                    // triggers in functions/index.js - Admin SDK, bypasses
                    // this rule) - frozen the same way as every other
                    // server-computed field above, so a client can never
                    // self-grant a higher tier/level (and the fee discount
                    // that comes with it, see walletService.js's
                    // chargeProductPurchase) with a direct write.
                    && request.resource.data.get('tier', null) == resource.data.get('tier', null)
                    && request.resource.data.get('tierLabel', null) == resource.data.get('tierLabel', null)
                    && request.resource.data.get('tierPoints', 0) == resource.data.get('tierPoints', 0)
                    && request.resource.data.get('level', 0) == resource.data.get('level', 0)
                    && request.resource.data.get('levelPoints', 0) == resource.data.get('levelPoints', 0)
                    && (
                      request.auth.uid == uid
                      || isAdmin()
                      || (isDealerTier() && resource.data.dealerId == myDealerScope())
                    );
      allow delete: if false;
    }

    // ---- securityPins/{uid}: the salted+hashed secondary "security PIN"
    // (My Documents view/share, Transfer Points send, Notepad - see
    // requireSecurityPin() in AppContext.js) plus its attempt counter and
    // lockout timestamp. Only ever read/written by setupSecurityPin/
    // verifySecurityPin/resetSecurityPin (functions/securityPinService.js)
    // via the Admin SDK, which bypasses these rules entirely - so, same
    // pattern as otps/{phone} and userIds/{id} above, the client has no
    // direct access at all. The public users/{uid}.securityPinSet flag
    // (frozen above) is what the UI reads instead.
    match /securityPins/{uid} {
      allow read, write: if false;
    }

    // ---- userIds/{id}: reservation docs backing the unique 4-5 digit
    // numeric userId every account gets (see functions/userId.js). Only
    // ever written by the Admin SDK inside assignUniqueUserId - same
    // pattern as otps/{phone} - so the client has no direct access. ----
    match /userIds/{id} {
      allow read, write: if false;
    }

    // ---- otps/{phone}: OTP codes for phone verification during
    // registration. Only ever read/written by the sendOtp/verifyOtp Cloud
    // Functions (functions/otpService.js) via the Admin SDK, which bypasses
    // these rules entirely - so the client never needs (or gets) direct
    // access. Blocking it here just makes that explicit. ----
    match /otps/{phone} {
      allow read, write: if false;
    }

    // ---- mergeOtps/{uid}: confirmation codes for the Google-account
    // merge flow (functions/accountMergeService.js:
    // startAccountMerge/confirmAccountMerge). Same shape and same reason
    // as otps/{phone} above - only ever touched by those two Cloud
    // Functions via the Admin SDK, so the client gets no direct access. ----
    match /mergeOtps/{uid} {
      allow read, write: if false;
    }

    // ---- activityLog/{id}: usage analytics (logins, screen views, key
    // actions) written directly by the client for its own uid - see
    // src/firebase/logService.js. Immutable once written - no client
    // update/delete. Only superadmin can read (Activity Logs screen,
    // sidebar-gated to superadmin - see Sidebar.js); this is an
    // operational/analytics collection, not something a user needs to
    // read back about themselves. A compromised client could write junk
    // here, but nothing security-relevant is ever decided from it - see
    // userAuditLog below for the collection that actually matters for
    // security, which the client can never write to at all. ----
    match /activityLog/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && isSuperadmin();
      allow update, delete: if false;
    }

    // ---- userAuditLog/{id}: account-security-relevant events (account
    // creation, role changes, dealer reassignment, OTP lockouts). Written
    // ONLY by Cloud Functions via the Admin SDK (functions/logService.js),
    // which bypass these rules - so the client has no write path here at
    // all, unlike activityLog above. That's what makes this a real audit
    // trail: a compromised or modified client can spam activityLog with
    // junk, but can never forge or erase an audit entry. Read restricted
    // to superadmin, same as activityLog/errorLog. ----
    match /userAuditLog/{id} {
      allow read: if signedIn() && isSuperadmin();
      allow write: if false;
    }

    // ---- errorLog/{id}: crash/error reports. A lightweight in-app-visible
    // backup so admins can see errors without leaving the app - not a
    // replacement for a real crash tool (Sentry/Crashlytics) client-side,
    // or Cloud Logging server-side. Two writers: the client reports its
    // own errors directly (source: 'client', capped to its own uid, same
    // trust level as activityLog); Cloud Functions report server errors
    // via the Admin SDK (source: 'server'), bypassing this rule the same
    // way userAuditLog's writes do. Superadmin may mark an entry resolved,
    // but can't edit its actual content - that keeps the record honest. ----
    match /errorLog/{id} {
      allow create: if signedIn() && request.resource.data.source == 'client'
                    && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && isSuperadmin();
      allow update: if signedIn() && isSuperadmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['resolved', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- inquiries/{id}: flight/bus/train, admin-contact model ----
    match /inquiries/{id} {
      allow create: if signedIn();
      // Customers can read their own inquiries; staff can read/manage all.
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaff());
      // Phase 10: Flight inquiries route to Reseller now (Dealer is
      // Mobile-Banking-only, see canHandleTransaction() above) - Admin
      // keeps universal override, same reasoning as canHandleTransaction.
      allow update: if signedIn() && (isAdmin() || isReseller());
      allow delete: if false;
    }

    // ---- transactions/{id}: broadcast order queue ----
    match /transactions/{id} {
      // All four services are created by walletService callables so the
      // customer's debit and order write are atomic.
      allow create: if signedIn() && !serviceIsChargeable(request.resource.data);

      // Customers read their own history. Staff read the broadcast queue.
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || isAdmin()
        || isDealerTier()
        || isReseller()
      );

      // First-accept-wins and claimer-only completion. Firestore's
      // transaction/retry semantics make concurrent accepts race-safe.
      // canHandleTransaction(resource.data.service) is the Phase 10
      // service-tier gate (Dealer: Mobile Banking only, Reseller:
      // Recharge/Internet/Remittance, Admin: everything) - see that
      // function above for why.
      allow update: if signedIn() && (
        (
          canHandleTransaction(resource.data.get('service', null))
          && resource.data.status == 'pending'
          && resource.data.claimedBy == null
          && request.resource.data.status == 'processing'
          && request.resource.data.claimedBy == request.auth.uid
        )
        ||
        (
          canHandleTransaction(resource.data.get('service', null))
          && resource.data.status == 'processing'
          && resource.data.claimedBy == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.get('pin', '') != ''
          && request.resource.data.get('receiptUrl', '') != ''
        )
      )
      && request.resource.data.get('customerId', null) == resource.data.get('customerId', null)
      && request.resource.data.get('pointsCharged', null) == resource.data.get('pointsCharged', null)
      && request.resource.data.get('service', null) == resource.data.get('service', null);

      allow delete: if false;
    }

    // ---- topups/{id}: customer/dealer point top-up requests (bank
    // transfer/deposit receipt -> admin review -> walletBalance credited
    // 1 RM = 1 point on approval, via topupService.approveTopup) ----
    match /topups/{id} {
      // A user can only file a request under their own uid, and only ever
      // create it as 'pending' - approving/rejecting is an update, not a
      // create, so this can't be used to self-approve.
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // The requester can see their own request's status; only admins see
      // the full queue (dealers submit requests but don't review others').
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Review happens ONLY through approveTopup/rejectTopup
      // (functions/walletService.js), via the Admin SDK - never a direct
      // client update, even from an admin. That's what stops a topup
      // being marked 'approved' here without the matching walletBalance
      // credit actually happening (those two writes now live inside one
      // Firestore transaction together, server-side, so they can't drift
      // apart the way two independent client writes could).
      allow update: if false;
      allow delete: if false;
    }

    // ---- selfTopups/{id}: admin/superadmin buying points for their own
    // account (see src/firebase/topupService.js createSelfTopup). Distinct
    // collection from topups/{id} above so a staff member's own purchase
    // never lands in the customer/dealer approval queue. Written ONLY by
    // the createSelfTopup Cloud Function (functions/walletService.js),
    // same reasoning as topups/{id}'s update rule above - a direct client
    // create here could forge a record claiming points were credited
    // when they never actually were. Each staff member can still read
    // their own. ----
    match /selfTopups/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---- gamePoints/{uid} + gamePointsLedger/{id}: the play-money balance
    // functions-gamebot uses for room games (dice/lowcard/highcard/
    // cricket/29 - no real money in the games themselves, see
    // roomChatService.js's GameBot comments) and its audit trail. Written
    // ONLY by functions-gamebot itself (entry fees/winnings, deployed
    // separately - see functions-gamebot/pointsLedger.js) and by
    // chargeGamePoints here (functions/walletService.js, wallet-point
    // recharges) - both go through the Admin SDK, never a direct client
    // write, same "server is the only writer" reasoning as topups/
    // selfTopups above. A user can read their own balance and their own
    // ledger rows only. ----
    match /gamePoints/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
    match /gamePointsLedger/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---- gameBotSessions/{roomId}: in-progress room-game state (active
    // players, round, pot) - written and read ONLY by functions-gamebot
    // (see sessionManager.js), via the Admin SDK, which bypasses these
    // rules entirely. No client read/write path - the client only ever
    // sees the game play out through roomChats/{roomId}/messages, same as
    // any other room member. ----
    match /gameBotSessions/{roomId} {
      allow read, write: if false;
    }

    // ---- gamePointsTransfers/{id}: audit trail / history for user-to-user
    // Game Points sends (play money only, no wallet/real money involved -
    // see transferGamePoints in functions/walletService.js, the only
    // writer). Unlike pointTransfers above there's no dealer-pool scoping
    // since any signed-in user can send Game Points to any other, so read
    // access is just "either side of the transfer". ----
    match /gamePointsTransfers/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create, update, delete: if false;
    }

    // ---- gamePointsGifts/{idempotencyKey}: immutable audit ledger for the
    // Next Update PRD's Game Point Gifting feature (80/20 split - see
    // giftGamePoints in functions/walletService.js, the only writer). Doc
    // ID is the client-supplied idempotency key, not auto-generated, so
    // giftGamePoints can detect and safely replay a duplicate submit
    // inside its own transaction. Read access is either side of the
    // gift, same scoping as gamePointsTransfers above. ----
    match /gamePointsGifts/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid);
      allow create, update, delete: if false;
    }

    // ---- supportTickets/{id}: customer/dealer support requests (subject +
    // message) reviewed by Admin - separate from the live chats/{uid}
    // thread above, which is real-time messaging rather than a trackable
    // ticket with a status. See src/firebase/supportTicketService.js. ----
    match /supportTickets/{id} {
      // A user can only file a ticket under their own uid, and only ever
      // create it as 'open' - moving it to in_progress/resolved is an
      // update, not a create.
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open';
      // The requester can see their own ticket's status. Superadmin sees
      // the full incoming queue - every new ticket lands with them first.
      // An admin/dealer/dealer only sees a ticket once superadmin has
      // appointed them to it.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isSuperadmin()
        || (isStaff() && resource.data.assignedToUid == request.auth.uid)
      );
      // Superadmin can change anything on a ticket, including who it's
      // assigned to. An appointed admin/dealer/dealer can move its
      // status (start/resolve/reopen) but can't reassign it elsewhere -
      // only superadmin hands tickets off.
      allow update: if signedIn() && (
        isSuperadmin()
        || (
          isStaff()
          && resource.data.assignedToUid == request.auth.uid
          && request.resource.data.assignedToUid == resource.data.assignedToUid
          && request.resource.data.assignedToName == resource.data.assignedToName
          && request.resource.data.assignedToRole == resource.data.assignedToRole
        )
      );
      allow delete: if false;
    }

    // ---- rates/current: shown to every signed-in customer, editable by admins ----
    match /rates/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    // ---- settings/pricing: dealer point-transfer earning % and mobile
    // recharge cost/profit % - see src/firebase/settingsService.js. Same
    // read-all/write-admin shape as rates/{id} above, EXCEPT the
    // `rolePricing` field (per-role price overrides, Admin > Pricing >
    // Role-Based Pricing) - that one's superadmin-only, matching the UI
    // gate in AdminHomeScreen, so a plain admin can't grant/change a
    // role's price even with a direct write. settings/paymentMethods (JomPay
    // biller ID/ref + DuitNow QR - see paymentSettingsService.js) is
    // superadmin-only for the WHOLE doc, not just one field, since it holds
    // the platform's actual billing credentials - matching the Admin >
    // Payments UI gate. settings/featureAccess (which roles can open each
    // admin/dealer/reseller management tool - see featureAccessService.js)
    // is superadmin-only for the same reason - matching the Superadmin >
    // Feature Access UI gate, so a plain admin can't grant themself or
    // anyone else extra tools with a direct write. ----
    match /settings/{id} {
      allow read: if signedIn();
      // settings/progression (Tier/Level thresholds + per-tier promotions -
      // see functions/progressionService.js and Superadmin > Tier
      // Promotions) is superadmin-only the same way paymentMethods/
      // featureAccess are - a plain admin granting themselves or a favored
      // customer a bigger fee discount is exactly the kind of direct-write
      // abuse this whole allowlist exists to stop.
      // homepageConfig (Next Update PRD §2 - Country/Region homepage
      // module toggles, see homepageConfigService.js) joins
      // paymentMethods/featureAccess/progression as superadmin-only for
      // the same reason: it's a platform-wide behavior switch, not a
      // per-transaction price a plain admin should be able to nudge.
      allow write: if signedIn() && isAdmin() &&
        (isSuperadmin() ||
         (id != 'paymentMethods' && id != 'featureAccess' && id != 'progression' && id != 'homepageConfig' &&
          request.resource.data.get('rolePricing', {}) ==
            (resource != null ? resource.data.get('rolePricing', {}) : {})));
    }

    // ---- internetPricing/{operator}: admin-editable price overrides for
    // internet data packages, one doc per operator - see
    // src/firebase/internetPricingService.js. Same read-all/write-admin
    // shape as rates/{id} above. ----
    match /internetPricing/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    // ---- categories/{module}: admin-editable Buy & Sell / Local Services
    // category lists (Admin Panel > Category Management in the sitemap) -
    // see src/firebase/categoryService.js. Same read-all/write-admin shape
    // as rates/{id} above; falls back to hardcoded defaults client-side
    // until a doc exists for that module. ----
    match /categories/{module} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    // ---- banners/{id}: home page slider slides, shown to every signed-in
    // user, managed from Admin > Banners (src/firebase/bannerService.js).
    // Deletion is a real delete here (not a status flag) since a removed
    // banner has no history worth keeping, unlike orders/inquiries. ----
    match /banners/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    // ---- announcements/{id}: history log of admin push broadcasts, written
    // only by the sendAnnouncement Cloud Function (functions/announcements.js)
    // via the Admin SDK, which re-checks the caller is admin/superadmin
    // before writing - so this is read-only from the client, same as
    // otps/{phone}. Admins read the full history on Admin > Announcements;
    // every other signed-in user reads it too (client-side filtered to
    // audience 'all' or their own role) to power their notification bell -
    // the content was already broadcast to them via push, so there's
    // nothing sensitive being exposed by letting them read the log. ----
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- chats/{customerUid}: WhatsApp-style thread between a customer and
    // staff. The doc ID is always the customer's own uid, so a customer can
    // only ever have exactly one thread and it's trivially scoped to them;
    // staff can read/update every thread to run the shared Chats inbox. ----
    match /chats/{chatId} {
      allow read: if signedIn() && (chatId == request.auth.uid || isStaff());
      allow create: if signedIn() && (chatId == request.auth.uid || isStaff());
      // General thread updates (unread counters, last-message preview,
      // ensureChat's initial doc) stay open to any staff member, same as
      // before. Changing who's assigned is admin/superadmin only - even
      // though the "Assign to" UI is already admin-gated (see
      // AdminSupportScreen.js / ChatScreen.js's canAssign), this is the
      // actual enforcement point so a dealer/dealer client can't call
      // chatService.assignChat() directly and have it succeed.
      allow update: if signedIn() && (
        (chatId == request.auth.uid || isStaff())
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['assignedToUid', 'assignedToName', 'assignedToRole'])
          || isAdmin()
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (chatId == request.auth.uid || isStaff());
        // You can only ever post a message as yourself, into your own
        // thread (customer) or any thread (staff).
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
                      && (chatId == request.auth.uid || isStaff());
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---- pointTransfers/{id}: audit trail for staff-to-staff/customer
    // wallet transfers (see src/firebase/pointTransferService.js). The
    // actual balance movement happens as two users/{uid} updates in one
    // client transaction - this doc is just the receipt, written right
    // after that transaction commits. Only the sender can write it (and
    // only naming themselves as sender), which is enough since the real
    // money-safety check (balance can't go negative) lives on the
    // users/{uid} update rule above, not here. ----
    // ---- pointTransfers/{id}: audit trail for staff-to-staff/customer
    // wallet transfers. Written ONLY by the transferPoints Cloud Function
    // (functions/walletService.js) - the actual balance movement now
    // happens there too, as one server-side Firestore transaction covering
    // both users/{uid} updates and this receipt together, so they can
    // never drift apart the way two independent client writes could
    // (which is also why a client create is no longer allowed here at
    // all, unlike before). ----
    match /pointTransfers/{id} {
      // Either side of the transfer can read it; admin sees everything;
      // a dealer/dealer sees transfers tagged with their own pool
      // (dealerId), same scoping as transactions/{id} above.
      allow read: if signedIn() && (
        request.auth.uid in resource.data.participants
        || isAdmin()
        || (isDealerTier() && resource.data.dealerId == myDealerScope())
      );
      allow create, update, delete: if false;
    }

    // ---- calls/{callId}: voice/video call signaling (see
    // src/firebase/callService.js). Two shapes share this collection:
    //   - 1:1 (isGroup unset/false): only callerUid/calleeUid can ever see
    //     or touch the doc, neither can change after creation, and the doc
    //     always starts out 'ringing'.
    //   - group (isGroup == true): anyone in participantUids can see or
    //     touch the doc; participantUids/callerUid/groupId/channelName can
    //     never change after creation. ringingUids/activeUids/status are
    //     the only fields later updates may touch.
    // `resource.data.isGroup != true` also covers docs from before group
    // calls existed, which have no isGroup field at all.
    match /calls/{callId} {
      allow read: if signedIn() && (
        (resource.data.get('isGroup', false) == true && request.auth.uid in resource.data.participantUids) ||
        (resource.data.get('isGroup', false) != true && (
          request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid
        ))
      );
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerUid
                    && request.resource.data.status == 'ringing'
                    && (
                      (request.resource.data.get('isGroup', false) == true
                        && request.auth.uid in request.resource.data.participantUids
                        && request.resource.data.activeUids == [request.auth.uid])
                      || request.resource.data.get('isGroup', false) != true
                    );
      // Either side of a 1:1 call, or any invited participant of a group
      // call, can update (accept/decline/leave/end) but never reassign who
      // the call is between/for.
      allow update: if signedIn() && (
        (resource.data.get('isGroup', false) == true && request.auth.uid in resource.data.participantUids
          && request.resource.data.get('isGroup', false) == resource.data.get('isGroup', false)
          && request.resource.data.get('groupId', null) == resource.data.get('groupId', null)
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.channelName == resource.data.channelName
          && request.resource.data.participantUids == resource.data.participantUids)
        ||
        (resource.data.get('isGroup', false) != true
          && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid)
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.calleeUid == resource.data.calleeUid)
      );
      allow delete: if false;
    }

    // ---- directChats/{chatId}: 1:1 messaging between any two accounts, any
    // mix of roles - separate from chats/{customerUid} (customer <-> Support
    // only) and groupChats/{groupId}. Doc ID is the two participants' uids
    // sorted and joined (see directChatId() in directChatService.js), so
    // `participants` is always exactly those two uids. ----
    match /directChats/{chatId} {
      // `resource == null` covers ensureDirectChat()'s getDoc() existence
      // check before the thread has been created - on a nonexistent doc,
      // `resource` is null, so `resource.data.participants` alone would
      // throw and deny the read outright, breaking every first-time chat.
      //
      // The `underInvestigation` clause is the one exception to "only the
      // two participants can read this thread": a superadmin may read it
      // while it's flagged true. That flag is only ever set/cleared by
      // Cloud Functions (see onDirectChatReportCreated/Updated in
      // functions/index.js) in response to a directChatReports doc, never
      // by a client directly - so a superadmin can't just grant themself
      // access to an arbitrary conversation.
      allow read: if signedIn() && (
        resource == null
        || request.auth.uid in resource.data.participants
        || (isSuperadmin() && resource.data.get('underInvestigation', false) == true)
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      // Either participant can update (send-preview bump, marking their own
      // unread count read) but can never change who the two participants are.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        // Same underInvestigation exception as the parent doc above - a
        // superadmin investigating an open report can read the messages,
        // but (per the create rule below, unchanged) can never send one;
        // they're not a participant.
        allow read: if signedIn()
                    && (
                      request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants
                      || (isSuperadmin() && get(/databases/$(database)/documents/directChats/$(chatId)).data.get('underInvestigation', false) == true)
                    );
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants
                      && !isBlockedByRecipient(chatId, request.auth.uid);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---- directChatReports/{reportId}: "Report conversation" (Marketplace
    // PRD section 11). Write-only from the client, same shape as
    // marketplaceReports/etc above - the reporter can read their own
    // reports back, admin can read all. There's no content to auto-hide
    // here (it's a private 1:1 thread, not a public post), so this is
    // purely an admin-visibility signal; functions/index.js's
    // onDirectChatReportCreated just pings the admin/superadmin roles. ----
    match /directChatReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- groupChats/{groupId}: multi-person threads (staff <-> staff,
    // staff <-> customers, customer <-> customer, etc). Only current
    // members can read/post; any signed-in account can create a group (the
    // creator must be one of its own members), but changing who's in an
    // existing group (adding/removing members updates memberUids) stays
    // staff-only - see the update rule below. ----
    match /groupChats/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.memberUids;
      // A member can update the doc (send-message preview bump, marking
      // their own unread count read) as long as they don't add/remove
      // themselves or anyone else from memberUids unless they're staff.
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
                    && (request.resource.data.memberUids == resource.data.memberUids || isStaff());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberUids;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberUids;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---- roomChats/{roomId}: community rooms - any signed-in account may
    // create one (unlike groupChats, which is staff-only) and becomes its
    // owner/first admin. Room metadata (name, description, rules,
    // memberUids/adminUids/pendingUids/bannedUids) is readable by anyone
    // signed in so open/approval rooms can be browsed before joining;
    // messages themselves are member-only. Mute is enforced client-side
    // (the compose box is hidden) rather than in these rules, matching how
    // this app already trusts the client for role-gated UI elsewhere.
    // gameBotGame (set via RoomSettingsScreen -> roomChatService.
    // setRoomGameBot/removeRoomGameBot) is just another field on this doc,
    // so it's covered by the existing "admin may change fields freely"
    // branch below - no separate rule needed. Only the room admin (client)
    // ever writes it; the functions-gamebot Cloud Function only reads it
    // and never writes to this document. ----
    match /roomChats/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid
                    && request.auth.uid in request.resource.data.memberUids
                    && request.auth.uid in request.resource.data.adminUids;
      // An admin may change membership/moderation fields freely. A
      // moderator (moderatorUids) may mute/unmute, kick, ban/unban
      // (memberUids/bannedUids), and approve/reject join requests
      // (pendingUids/memberUids), but can't touch adminUids,
      // moderatorUids, ownerUid, or room settings (name/description/
      // rules/type/adminsOnlyPost/gameBotGame) - promoteToModerator/
      // demoteModerator themselves go through the admin branch above
      // since only an admin can call them. A regular member may only
      // touch their own unread counter, agree to the rules, or add
      // themselves to memberUids (open room) / pendingUids (approval
      // room) - never remove/add anyone else or touch adminUids.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.adminUids ||
        (
          request.auth.uid in resource.data.get('moderatorUids', []) &&
          request.resource.data.adminUids == resource.data.adminUids &&
          request.resource.data.get('moderatorUids', []) == resource.data.get('moderatorUids', []) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.description == resource.data.description &&
          request.resource.data.rules == resource.data.rules &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.get('adminsOnlyPost', false) == resource.data.get('adminsOnlyPost', false) &&
          request.resource.data.get('gameBotGame', null) == resource.data.get('gameBotGame', null)
        ) ||
        (
          request.resource.data.adminUids == resource.data.adminUids &&
          request.resource.data.get('moderatorUids', []) == resource.data.get('moderatorUids', []) &&
          request.resource.data.bannedUids == resource.data.bannedUids &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          (
            request.auth.uid in resource.data.memberUids ||
            request.auth.uid in request.resource.data.memberUids ||
            request.auth.uid in request.resource.data.pendingUids
          )
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/roomChats/$(roomId)).data.memberUids;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/roomChats/$(roomId)).data.memberUids
                      && !(request.auth.uid in get(/databases/$(database)/documents/roomChats/$(roomId)).data.mutedUids);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---- marketplaceListings/{listingId}: Buy & Sell classifieds (Phase 1
    // of the Marketplace PRD). Any signed-in account can list; readable by
    // anyone signed in (including 'hidden' ones, so a seller/admin can
    // still see why - the client just filters status=='active' for the
    // public feed). Only the seller or an admin can edit/delete, and
    // sellerId can never change hands. reportCount is bumped server-side
    // only (see functions/index.js onMarketplaceReportCreated) - it's
    // absent from both allow blocks below on purpose, so no client write
    // ever needs to touch it. ----
    match /marketplaceListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    // sellerVerified is a denormalized snapshot of the
                    // seller's badge at listing-creation time (Phase 3,
                    // see recommendationService.js-style comment in
                    // marketplaceService.js) - checked against the
                    // caller's own profile server-side so a client can't
                    // just write sellerVerified: true for itself. It's a
                    // snapshot, not live, same tradeoff as sellerName/
                    // sellerRole above: a badge earned/lost after this
                    // listing was posted won't retroactively update it.
                    && request.resource.data.get('sellerVerified', false) == myProfile().get('verified', false)
                    // sellerIsBusiness is the same denormalized-snapshot
                    // trick as sellerVerified just above, for the "🏢
                    // Business" feed badge (PRD section 15) - a Business
                    // Profile granted/revoked after this listing was
                    // posted won't retroactively update it.
                    && request.resource.data.get('sellerIsBusiness', false) == myIsBusiness()
                    // featured/featuredUntil start unset - only the
                    // boostListing Cloud Function (Admin SDK, bypasses
                    // these rules) can turn a listing featured, same
                    // pattern as walletBalance below.
                    && request.resource.data.get('featured', false) == false;
      allow update: if signedIn() && (
        (resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == resource.data.sellerId
          // A seller can edit their own listing freely, but not
          // self-feature it - featured/featuredUntil must pass through
          // unchanged on any client-originated update. The boostListing
          // Cloud Function (functions/walletService.js) uses the Admin
          // SDK, which is exempt from these rules entirely, so it can
          // still set them after debiting the seller's wallet.
          && request.resource.data.get('featured', false) == resource.data.get('featured', false)
          && request.resource.data.get('featuredUntil', null) == resource.data.get('featuredUntil', null)
          // sellerIsBusiness is a creation-time snapshot (see the create
          // block above) - freezing it here too so a seller can't just
          // edit their own listing afterward to grant themselves the paid
          // "🏢 Business" badge. A business granted status after posting
          // picks it up next time they create a new listing, not by
          // editing an old one.
          && request.resource.data.get('sellerIsBusiness', false) == resource.data.get('sellerIsBusiness', false))
        || isAdmin()
      );
      allow delete: if signedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ---- marketplaceSaves/{uid_listingId}: one user's "Saved Items" -
    // doc id is deterministic (uid_listingId) so save/unsave is a direct
    // doc write with no query, and each user can only ever read/write
    // their own saves. ----
    match /marketplaceSaves/{saveId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && saveId == request.auth.uid + '_' + request.resource.data.listingId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- marketplaceViews/{uid}: rolling log of categories a user has
    // viewed, feeding the "Recommended for You" row on the marketplace
    // home screen (Phase 3, see recommendationService.js). Doc id is the
    // uid itself - one doc per user, read/write only by its own owner.
    // No admin/other-user read: this is behavioral data, not moderation
    // data, so it doesn't need the read-your-own-plus-admin pattern used
    // by marketplaceReports below. ----
    match /marketplaceViews/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn()
                    && uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---- verificationRequests/{uid}: identity verification submission for
    // the "Verified" seller badge (Phase 3, PRD section 12 + the sitemap's
    // Admin Panel > Verification Management - see verificationService.js).
    // Doc id is the uid itself - one "current" request per user, same
    // pattern as marketplaceViews above. The client can only ever write
    // status: 'pending' here (submit/resubmit); actually granting the
    // badge (status -> 'approved', plus setting users/{uid}.verified) only
    // happens through the approveVerification/rejectVerification Cloud
    // Functions (functions/verificationService.js) via the Admin SDK,
    // which bypasses this rule entirely - so a client write can never
    // self-approve. Resubmission is blocked once a request is already
    // approved (nothing left to review) but allowed again after a
    // rejection. ----
    match /verificationRequests/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if signedIn()
                    && uid == request.auth.uid
                    && resource.data.status != 'approved'
                    && request.resource.data.status == 'pending';
      allow delete: if false;
    }

    // ---- businessProfiles/{uid}: public "Business Profile" (Marketplace
    // PRD section 15 Monetization Plan - "Business profile"). Doc id is
    // the uid, same pattern as verificationRequests above. Unlike
    // users/{uid} (only the owner/admin/scoped-dealer can read that doc),
    // this is a small PUBLIC snapshot - businessName, businessLogoUrl,
    // businessDescription, businessCategory, plus the isBusinessProfile
    // flag itself - so any signed-in user can look up a seller/owner/
    // provider's business profile from a listing/property/service's
    // detail screen (see BusinessProfileScreen.js). The owner can freely
    // edit their own display fields, but isBusinessProfile is frozen on
    // every client write, and "create" is blocked entirely - it is only
    // ever granted (which also creates this doc the first time) or
    // revoked by the setBusinessProfileStatus Cloud Function
    // (functions/businessProfileService.js, Admin SDK, admin-only), so
    // there is no client-writable path to granting yourself the badge -
    // same story as users/{uid}.verified. ----
    match /businessProfiles/{uid} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if signedIn() && uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.isBusinessProfile == resource.data.isBusinessProfile;
      allow delete: if false;
    }

    // ---- marketplaceReports/{reportId}: "Report Product" - write-only
    // from the client (the reporter can read their own reports back;
    // admin can read all for moderation). The actual moderation action
    // (bumping the listing's reportCount, auto-hiding past the threshold)
    // happens in functions/index.js via the Admin SDK, not through a
    // client update here. ----
    match /marketplaceReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      // Admin moderation (Marketplace Admin Panel > Manage reports) only
      // ever touches these three fields - reason/note/reporterId etc.
      // stay frozen so a report can't be rewritten after the fact.
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- properties/{propertyId}: Accommodation listings (Phase 2 of the
    // Marketplace PRD). Mirrors marketplaceListings above - any signed-in
    // account can list; readable by anyone signed in (including 'hidden'
    // ones, so an owner/admin can still see why - the client just filters
    // status=='active' for the public feed). Only the owner or an admin
    // can edit/delete, and ownerId can never change hands. reportCount is
    // bumped server-side only (see functions/index.js
    // onAccommodationReportCreated) - it's absent from both allow blocks
    // below on purpose, so no client write ever needs to touch it. ----
    match /properties/{propertyId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    // ownerIsBusiness - same denormalized-snapshot "🏢
                    // Business" feed badge as marketplaceListings.sellerIsBusiness
                    // above (PRD section 15).
                    && request.resource.data.get('ownerIsBusiness', false) == myIsBusiness();
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId
          // ownerIsBusiness is a creation-time snapshot - frozen here too,
          // same reasoning as marketplaceListings.sellerIsBusiness above.
          && request.resource.data.get('ownerIsBusiness', false) == resource.data.get('ownerIsBusiness', false))
        || isAdmin()
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- propertySaves/{uid_propertyId}: one user's "Saved Properties" -
    // doc id is deterministic (uid_propertyId) so save/unsave is a direct
    // doc write with no query, and each user can only ever read/write
    // their own saves. ----
    match /propertySaves/{saveId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && saveId == request.auth.uid + '_' + request.resource.data.propertyId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- propertyReports/{reportId}: "Report Property" - write-only from
    // the client (the reporter can read their own reports back; admin can
    // read all for moderation). The actual moderation action (bumping the
    // property's reportCount, auto-hiding past the threshold) happens in
    // functions/index.js via the Admin SDK, not through a client update
    // here. ----
    match /propertyReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- roommateRequests/{requestId}: Room Sharing requests (Phase 2 of
    // the Marketplace PRD). Mirrors properties above - any signed-in
    // account can post; readable by anyone signed in (including 'hidden'
    // ones, so a poster/admin can still see why - the client just filters
    // status=='active' for the public feed). Only the poster or an admin
    // can edit/delete, and posterId can never change hands. reportCount is
    // bumped server-side only (see functions/index.js
    // onRoommateReportCreated). ----
    match /roommateRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.posterId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0;
      allow update: if signedIn() && (
        (resource.data.posterId == request.auth.uid && request.resource.data.posterId == resource.data.posterId)
        || isAdmin()
      );
      allow delete: if signedIn() && (resource.data.posterId == request.auth.uid || isAdmin());
    }

    // ---- roommateReports/{reportId}: "Report" a roommate request -
    // write-only from the client (the reporter can read their own reports
    // back; admin can read all for moderation). The actual moderation
    // action happens in functions/index.js via the Admin SDK. ----
    match /roommateReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- serviceProviders/{providerId}: Local Services provider profiles
    // (Phase 2 of the Marketplace PRD, section 8). Mirrors properties
    // above - any signed-in account can post; readable by anyone signed
    // in (including 'hidden' ones, so an owner/admin can still see why -
    // the client just filters status=='active' for the public feed). Only
    // the owner or an admin can edit/delete, and ownerId can never change
    // hands. reportCount is bumped server-side only (see
    // functions/index.js onServiceProviderReportCreated).
    //
    // The one exception to "owner-only update" is ratingSum/ratingCount:
    // serviceReviewService.submitReview runs a client-side transaction
    // that updates these two fields (plus updatedAt) on behalf of
    // whichever user is leaving the review, not the provider's owner - see
    // that file's comment for why this is safe to do client-side rather
    // than through a Cloud Function the way reportCount is. The second
    // allow-update branch below permits exactly that: any signed-in user,
    // touching only those three fields, on a provider they don't own. ----
    match /serviceProviders/{providerId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.ratingCount == 0
                    // ownerIsBusiness - same denormalized-snapshot "🏢
                    // Business" feed badge as marketplaceListings.sellerIsBusiness
                    // above (PRD section 15).
                    && request.resource.data.get('ownerIsBusiness', false) == myIsBusiness();
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId
          // ownerIsBusiness is a creation-time snapshot - frozen here too,
          // same reasoning as marketplaceListings.sellerIsBusiness above.
          && request.resource.data.get('ownerIsBusiness', false) == resource.data.get('ownerIsBusiness', false))
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'updatedAt'])
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- serviceProviderReports/{reportId}: "Report" a service provider -
    // write-only from the client (the reporter can read their own reports
    // back; admin can read all for moderation). The actual moderation
    // action happens in functions/index.js via the Admin SDK. ----
    match /serviceProviderReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- serviceReviews/{uid_providerId}: one reviewer's review of one
    // provider - doc id is deterministic (uid_providerId), same trick as
    // propertySaves above, so "submit or edit my review" is a direct doc
    // write with no query. Readable by anyone signed in (reviews are
    // public, like the provider profile they're attached to). Only the
    // reviewer can create/update their own review, and reviewerId/
    // providerId can never change hands on an edit. Deletion isn't
    // exposed client-side (no screen calls it) so it stays admin-only,
    // matching how every other report/review-adjacent collection in this
    // file treats delete. ----
    match /serviceReviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    && reviewId == request.auth.uid + '_' + request.resource.data.providerId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if signedIn()
                    && resource.data.reviewerId == request.auth.uid
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.providerId == resource.data.providerId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // ---- communityPosts/{postId}: Community module - Jobs/Events/Lost &
    // Found/Emergency/News posts (PRD section 9). Mirrors marketplaceListings
    // above - any signed-in account can post; readable by anyone signed in
    // (including 'hidden' ones, so an author/admin can still see why - the
    // client just filters status=='active' for the public feed). Only the
    // author or an admin can edit/delete, and authorId can never change
    // hands. reportCount is bumped server-side only (see functions/index.js
    // onCommunityReportCreated). likeCount/commentCount are the one
    // exception to "author-only update" - same pattern serviceProviders
    // above uses for ratingSum/ratingCount: any signed-in user liking a
    // post or leaving a comment touches only that one counter field on a
    // post they don't own. ----
    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0;
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt'])
      );
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- communityLikes/{uid_postId}: one user's "like" on a Community
    // post - doc id is deterministic (uid_postId), same trick as
    // marketplaceSaves above, so like/unlike is a direct doc write with no
    // query, and each user can only ever read/write their own likes. ----
    match /communityLikes/{likeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.auth.uid + '_' + request.resource.data.postId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- communityComments/{commentId}: comments on a Community post -
    // public read (comments are visible to anyone viewing the post, like a
    // chat thread's messages), write-once from the client (no edit - only
    // the commenter or an admin can delete, matching every other
    // report/comment-adjacent collection in this file). ----
    match /communityComments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- communityReports/{reportId}: "Report" a Community post -
    // write-only from the client (the reporter can read their own reports
    // back; admin can read all for moderation). The actual moderation
    // action (bumping the post's reportCount, auto-hiding past the
    // threshold) happens in functions/index.js via the Admin SDK. ----
    match /communityReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- socialPosts/{postId}: Social Feed - general Facebook-style posts
    // (Next Update PRD §3), distinct from the typed Community module above.
    // Exact mirror of communityPosts, minus the 'closed' status (a general
    // post has nothing to mark resolved) and plus shareCount as a third
    // client-incremented counter alongside likeCount/commentCount. ----
    match /socialPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !isMarketplaceBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.reportCount == 0
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.shareCount == 0;
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount', 'updatedAt'])
      );
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- socialLikes/{uid_postId}: one user's "like" on a Social Feed
    // post - same deterministic-id trick as communityLikes above. ----
    match /socialLikes/{likeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.auth.uid + '_' + request.resource.data.postId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- socialComments/{commentId}: comments on a Social Feed post -
    // exact mirror of communityComments. ----
    match /socialComments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---- socialReports/{reportId}: "Report" a Social Feed post - exact
    // mirror of communityReports. The actual moderation action (bumping
    // reportCount, auto-hiding past the threshold) happens in
    // functions/index.js via the Admin SDK, see onSocialReportCreated. ----
    match /socialReports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if signedIn() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // ---- marketplaceReviews/{uid_sellerId}: one reviewer's review of one
    // Buy & Sell seller - doc id is deterministic (uid_sellerId), same
    // trick as serviceReviews below, so "submit or edit my review" is a
    // direct doc write with no query. Readable by anyone signed in
    // (reviews are public, like the seller's listings they're attached
    // to). Only the reviewer can create/update their own review, and
    // reviewerId/sellerId can never change hands on an edit. Deletion
    // isn't exposed client-side so it stays admin-only. ----
    match /marketplaceReviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.reviewerId != request.resource.data.sellerId
                    && reviewId == request.auth.uid + '_' + request.resource.data.sellerId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if signedIn()
                    && resource.data.reviewerId == request.auth.uid
                    && request.resource.data.reviewerId == resource.data.reviewerId
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // ---- marketplaceSellerStats/{sellerId}: the ratingSum/ratingCount
    // aggregate behind a Buy & Sell seller's star rating (see
    // marketplaceReviewService.js's header comment for why this is a
    // standalone doc rather than living on a provider-style profile doc).
    // Created by whichever user leaves the seller's first review - so,
    // unlike every "owner-only" collection above, create/update here is
    // intentionally NOT limited to the seller themselves; it's limited to
    // exactly the three rating fields instead, which is what actually
    // keeps it safe (a reviewer can only ever add their own 1-5 into the
    // running sum via marketplaceReviewService.submitReview's paired
    // transaction, never set the aggregate directly to an arbitrary
    // value). ----
    match /marketplaceSellerStats/{sellerId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.sellerId == sellerId
                    && request.resource.data.keys().hasOnly(['sellerId', 'ratingSum', 'ratingCount', 'updatedAt']);
      allow update: if signedIn()
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'updatedAt']);
      allow delete: if false;
    }

    // ---- serviceRequests/{requestId}: Local Services "Request Service"
    // lead form (src/firebase/serviceRequestService.js) - a customer sends
    // a provider a short message, mirroring how inquiries/{id} above
    // handles Flight/Bus/Train (new -> contacted -> closed, no live
    // negotiation in this collection - that happens over Direct Chat
    // instead, same as the other three Marketplace modules' "contact"
    // buttons). Readable by whichever side of the request the caller is
    // on (the customer who sent it, or the owner of the provider profile
    // it was sent to) or an admin. Only the provider's owner may advance
    // status - the customer's role ends at sending it. ----
    match /serviceRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.providerOwnerId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if signedIn()
                    && (resource.data.providerOwnerId == request.auth.uid || isAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ---- myDocuments/{id}: private per-user document vault (passport,
    // visa, work permit, etc.) - see src/firebase/documentService.js.
    // Flat collection with a userId field, same convention as topups/{id}
    // above, rather than a users/{uid}/documents subcollection. Unlike
    // topups, there's no staff approval workflow here - it's purely the
    // user's own private data - so the owner can create/read/update/
    // delete their own records directly, and nobody else (not even
    // admin/superadmin) can read another user's documents. ----
    match /myDocuments/{documentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- notes/{id}: private per-user Notepad (general notes plus
    // Credit/Debit/Loan "money notes") - see src/firebase/notepadService.js.
    // Flat collection with a userId field, exact same convention and
    // privacy stance as myDocuments/{documentId} above: purely the user's
    // own private data, so the owner can create/read/update/delete their
    // own notes directly, and nobody else (not even admin/superadmin) can
    // read another user's notes. ----
    match /notes/{noteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- Salary & OT module (see src/firebase/salarySettingsService.js,
    // workLogService.js, allowanceService.js, deductionService.js,
    // salaryRecordService.js) - PRD section 22 specifies these as
    // users/{userId}/{collection}/{docId} subcollections, unlike every
    // other private per-user collection in this file (myDocuments above,
    // topups, etc.), which instead use a flat top-level collection with a
    // userId field - see the note on myDocuments/{documentId} above for
    // that convention. This module was built to the PRD's subcollection
    // model as a deliberate one-off rather than following that
    // convention, so keep that in mind if extending it or copying its
    // pattern elsewhere.
    //
    // Same privacy stance as myDocuments regardless: this is salary/
    // income data, arguably more sensitive than the documents themselves,
    // so ownership here is checked purely by uid path segment
    // (request.auth.uid == uid) with NO isAdmin() carve-out anywhere in
    // this block - not even admin/superadmin can read another user's
    // salary data. If a future support/admin workflow genuinely needs
    // visibility (e.g. a dispute review), that should be a narrow,
    // explicitly-scoped addition here, not a blanket isAdmin() read.
    match /users/{uid}/salarySettings/{settingsId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/workLogs/{workLogId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/allowances/{allowanceId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/deductions/{deductionId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // salaryRecords additionally freezes year/month on update - the doc
    // id is derived from them (salaryRecordService.recordId()), so
    // letting a client change either post-creation would desync the doc
    // id from its own content (e.g. an "August" record whose year/month
    // fields silently say September).
    match /users/{uid}/salaryRecords/{recordId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.year == resource.data.year
                    && request.resource.data.month == resource.data.month;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Create Payslip module (see src/firebase/payslipService.js) -
    // same users/{uid}/{collection} subcollection convention and same
    // owner-only-no-admin-carve-out stance as the rest of Salary & OT
    // above; payslips carry the same sensitive financial data plus
    // employer/employee personal details, so no read/write path exists
    // here for anyone but request.auth.uid == uid.
    match /users/{uid}/payslips/{payslipId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Singleton "default employer" doc (PRD section 5, "Save as Default
    // Employer") - same fixed-doc-id singleton shape as salarySettings
    // above.
    match /users/{uid}/payslipSettings/{settingsId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Friends list (see contactsService.js) - one doc per friend, keyed by
    // the friend's uid so adding the same person twice just overwrites
    // (idempotent) rather than creating duplicates. Purely a personal
    // bookmark list: only the owner can read/write their own, and a friend
    // being added here never grants the friend read access to anything of
    // the owner's - it's a one-directional list, like WhatsApp contacts,
    // not a mutual-follow relationship.
    match /users/{uid}/friends/{friendUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Per-caller ringtone/vibration overrides (see
    // callerRingtoneService.js) - one doc per caller the owner has
    // customized, keyed by the caller's uid so setting it twice just
    // overwrites. Same one-directional, owner-only-no-admin-carve-out
    // shape as friends above: this only affects how the *owner's own*
    // device rings for calls from that person, so a caller being
    // referenced here never grants them any access to anything of the
    // owner's.
    match /users/{uid}/callerRingtones/{callerUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ============================================================
    // PHASE 1 - Advertisement System (foundation only - see
    // src/types/ads.ts, src/firebase/adService.js, and the PHASE 1 brief
    // this section was written against). Every collection below is
    // config/data-layer only in this phase - no rendering, targeting, or
    // rotation logic reads any of it yet.
    //
    // Security model, applied consistently across all twelve collections:
    // write access is isSuperadmin() ONLY, never plain isAdmin() - this is
    // stricter than most other admin-config collections in this file
    // (settings/{id} above allows isAdmin() for most docs) because the
    // brief explicitly calls for Super Admin-only write on ad
    // configuration. A plain admin can read what's needed to see ad
    // performance, but cannot create, edit, approve, or reconfigure
    // anything here.
    // ============================================================

    // ---- advertisements/{adId}: the ad creative + targeting + schedule.
    // Read is any signed-in user - later phases render ads from this
    // collection to every role, same "content config, not sensitive data"
    // shape as banners/{id} and categories/{module} above. ----
    match /advertisements/{adId} {
      allow read: if signedIn();
      allow write: if signedIn() && isSuperadmin();
    }

    // ---- ad_campaigns/{campaignId}: groups advertisements under one
    // advertiser + budget + date range. Same read/write shape as
    // advertisements above. ----
    match /ad_campaigns/{campaignId} {
      allow read: if signedIn();
      allow write: if signedIn() && isSuperadmin();
    }

    // ---- ad_advertisers/{advertiserId}: the business/entity buying ad
    // space - company name, contact email/phone. Unlike advertisements/
    // ad_campaigns above, there's no customer-facing reason to browse this
    // (no UI shows "who's advertising" to a regular user), so read is
    // scoped to isAdmin() rather than any signed-in user - narrower by
    // default until a real need to open it further shows up. ----
    match /ad_advertisers/{advertiserId} {
      allow read: if signedIn() && isAdmin();
      allow write: if signedIn() && isSuperadmin();
    }

    // ---- ad_placements/{placementId}: admin-configured metadata for a
    // slot from PLACEMENT_IDS (src/constants/adPlacements.ts) - enabled
    // flag, max concurrent ads. Read is any signed-in user, since a later
    // phase's rendering code needs to check "is this placement enabled"
    // from every role's screens, not just admin's. ----
    match /ad_placements/{placementId} {
      allow read: if signedIn();
      allow write: if signedIn() && isSuperadmin();
    }

    // ---- ad_packages/{packageId}: a purchasable ad bundle (e.g. "7-day
    // home banner"). Scoped to isAdmin() read, same reasoning as
    // ad_advertisers above - no advertiser-facing self-service package
    // picker exists yet, so there's no confirmed need for broader read
    // access; easy to relax to signedIn() later if one gets built. ----
    match /ad_packages/{packageId} {
      allow read: if signedIn() && isAdmin();
      allow write: if signedIn() && isSuperadmin();
    }

    // ---- ad_impressions/{id}, ad_clicks/{id}: "this ad was shown/tapped"
    // events (see src/firebase/adTrackingService.js). Mirrors
    // activityLog's exact shape above: create-only, no update/delete -
    // same trust level (a compromised client could spam junk events, but
    // nothing security-relevant is ever decided from this collection -
    // see functions/adTrackingService.js's own trust-model note on the
    // one thing that IS derived from these events, totalImpressions/
    // totalClicks, which a client has no write path to at all).
    //
    // PHASE 6 - FREQUENCY: read is signedIn() && (own doc OR superadmin),
    // widened from superadmin-only, because adTrackingService.
    // canShowImpression/canRecordClick/canShowInterstitial need to COUNT
    // a user's own recent impressions/clicks client-side to enforce the
    // per-user frequency caps (see that file's TRUST MODEL note) - a user
    // could already spam events into this collection via `create` below,
    // so letting them read only what they themselves wrote back doesn't
    // expose anything new; they still can never read another user's
    // events.
    //
    // PHASE 7 - AD TRACKING: create no longer requires signedIn() at all.
    // The brief's "record userId when appropriate" means an impression/
    // click on a public/pre-login screen must still be recordable - it
    // simply carries no userId field rather than being rejected outright.
    // When userId IS present, it must still match the writer's own uid
    // (unchanged from PHASE 1/6) - nobody can attribute an event to
    // someone else's account; when userId is absent, that check is
    // skipped entirely rather than failing. ----
    match /ad_impressions/{id} {
      allow create: if !('userId' in request.resource.data)
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow read: if signedIn() && (isSuperadmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }
    match /ad_clicks/{id} {
      allow create: if !('userId' in request.resource.data)
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow read: if signedIn() && (isSuperadmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // ---- ad_reports/{id}: aggregated performance rollups, generated by a
    // later phase's scheduled Cloud Function from ad_impressions/
    // ad_clicks - never written by the client (matches how this app
    // already treats anything aggregated/analytical: computed
    // server-side, read-only to the client). Read is isAdmin() - unlike
    // the write-side superadmin-only rule everywhere else in this
    // section, viewing a performance report is a reasonable task for any
    // admin running a campaign, not just superadmin. ----
    match /ad_reports/{id} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    // ---- ad_payments/{paymentId}: an advertiser's payment for a
    // campaign/package. Never written by the client, same trust model
    // this app already uses for money-moving collections (transactions,
    // topups) - a later phase's Cloud Function is the only writer.
    // Read is isSuperadmin() only - financial records, matching
    // settings/paymentMethods' superadmin-only gating above. ----
    match /ad_payments/{paymentId} {
      allow read: if signedIn() && isSuperadmin();
      allow write: if false;
    }

    // ---- ad_daily_stats/{id}: PHASE 8 - pre-aggregated per-day-per-ad-
    // per-placement-per-feature impression/click rollups (see
    // src/types/ads.ts's AdDailyStat), written ONLY by
    // functions/adTrackingService.js's DAILY ROLLUP section via the Admin
    // SDK inside the same transaction that syncs advertisements/{adId}.
    // totalImpressions/totalClicks - never by the client, same
    // computed-server-side/read-only-to-the-client trust model as
    // ad_reports below. Read is isAdmin() (not isSuperadmin() - see
    // adAnalyticsService.js's own SCOPE comment: the brief's "Super Admin
    // advertisement analytics" title is enforced by AdAnalyticsScreen
    // gating on profile.role === 'superadmin' before it ever calls in
    // here, matching ad_reports' own slightly-wider-than-write isAdmin()
    // read rule below - a plain admin could technically read this
    // collection directly, the app's own navigation just never offers
    // them the screen). ----
    match /ad_daily_stats/{id} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    // ---- ad_audit_logs/{id}: security-relevant ad actions (approvals,
    // status changes, settings edits - see AD_AUDIT_ACTIONS in
    // src/constants/adEnums.ts). Mirrors userAuditLog above EXACTLY: a
    // later phase's Cloud Function writes here via the Admin SDK, which
    // bypasses these rules entirely - the client has no write path at
    // all, which is what makes this a real audit trail rather than
    // something a compromised client could forge or erase. ----
    match /ad_audit_logs/{id} {
      allow read: if signedIn() && isSuperadmin();
      allow write: if false;
    }

    // ---- ad_settings/{id}, ad_feature_controls/{featureId}: global ad
    // toggle + defaults, and per-feature ad enable/disable (doc id is a
    // FeatureId from src/constants/adFeatures.ts). Read is any signed-in
    // user - later phases need to check "are ads on for this feature"
    // from every role's screens - write is superadmin-only, same as
    // every other write rule in this section. ----
    match /ad_settings/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isSuperadmin();
    }
    match /ad_feature_controls/{featureId} {
      allow read: if signedIn();
      allow write: if signedIn() && isSuperadmin();
    }

    // Service API provider credentials are server-managed only. The app's
    // Superadmin API Management screen uses callable functions so raw API
    // keys/passwords never become readable by the client.
    match /api_providers/{providerId} {
      allow read, write: if false;
    }

    // Per-service processing mode (legacy vs api) - also server-managed only,
    // via getServiceApiSettings/saveServiceApiSettings. No client path reads
    // or writes this directly; explicit deny here (rather than relying on
    // the ruleset's default-deny with no catch-all) so intent holds even if
    // a wildcard rule is ever added elsewhere in this file.
    match /api_settings/{docId} {
      allow read, write: if false;
    }

  }
}
