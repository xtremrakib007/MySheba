rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return signedIn() ? myProfile().role : null; }
    function isStaff() { return myRole() in ['dealer', 'reseller', 'admin', 'superadmin']; }
    function isAdmin() { return myRole() in ['admin', 'superadmin']; }
    function isSuperadmin() { return myRole() == 'superadmin'; }
    function isDealerTier() { return myRole() == 'dealer'; }
    function isReseller() { return myRole() == 'reseller'; }
    function myDealerScope() { return request.auth.uid; }
    function canHandleTransaction(s) { return isAdmin() || (isDealerTier() && s == 'Mobile Banking') || (isReseller() && s in ['Recharge', 'Internet', 'Remittance']); }
    match /rates/current { allow read: if signedIn(); allow create: if isSuperadmin(); allow update: if isSuperadmin() || (myRole() == 'admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mobileBanking','remittanceFee','remittanceBD_ACC','remittanceBD_CASH','remittanceNP','remittancePK','remittancePH','remittanceLK','remittanceIN','remittanceID','remittanceMM','BD_ACC','BD_CASH','NP','PK','PH','LK','IN','ID','MM','updatedAt'])); allow delete: if false; }
    match /verificationRequests/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow create, update, delete: if false; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || (isDealerTier() && resource.data.dealerId == myDealerScope()) || (isReseller() && resource.data.get('resellerId', null) == request.auth.uid));
      allow create: if false;
      allow update: if signedIn() && ((request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['googleLinked','googleEmail','notifPrefs'])) || (isAdmin() && (resource.data.role != 'superadmin') && (resource.data.role != 'admin' || isSuperadmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled','features'])) || (isDealerTier() && resource.data.dealerId == myDealerScope() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]));
      allow delete: if false;
      match /receivers/{receiverId} { allow read, create, update, delete: if signedIn() && request.auth.uid == uid; }
      match /friends/{friendId} { allow read, create, update, delete: if signedIn() && request.auth.uid == uid; }
      match /workLogs/{workLogId} { allow read, create, update, delete: if signedIn() && (request.auth.uid == uid || isAdmin()); }
      match /payslips/{payslipId} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
      match /salaryRecords/{recordId} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
      match /allowances/{allowanceId} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
      match /deductions/{deductionId} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if isAdmin(); }
      match /trustedDevices/{deviceId} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow create, update, delete: if false; }
    }
    match /securityPins/{uid} { allow read, write: if false; }
    match /userIds/{id} { allow read, write: if false; }
    match /otps/{phone} { allow read, write: if false; }
    match /mergeOtps/{uid} { allow read, write: if false; }
    match /temporaryAuthCleanup/{uid} { allow read, write: if false; }
    match /activityLog/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read: if signedIn() && isSuperadmin(); allow update, delete: if false; }
    match /userAuditLog/{id} { allow read: if signedIn() && isSuperadmin(); allow write: if false; }
    match /errorLog/{id} { allow create: if signedIn() && request.resource.data.source == 'client' && request.resource.data.userId == request.auth.uid; allow read: if signedIn() && isSuperadmin(); allow update: if signedIn() && isSuperadmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedBy','resolvedAt']); allow delete: if false; }
    match /inquiries/{id} { allow create: if signedIn() && request.resource.data.customerId == request.auth.uid; allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaff()); allow update: if signedIn() && ((isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','ticketUrl','updatedAt']) && request.resource.data.status in ['new','contacted','closed']) || (isReseller() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['new','contacted','closed'])); allow delete: if false; }
    match /transactions/{id} {
      allow create: if false;
      // Dealer/reseller access to full transaction documents is intentionally removed.
      // They use the server-maintained sanitized transactionQueue instead.
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if signedIn() && ((isAdmin() && resource.data.status == 'pending' && resource.data.get('approved', false) != true && request.resource.data.get('approved', false) == true && request.resource.data.get('approvedBy', null) == request.auth.uid && request.resource.data.get('approvedByRole', null) in ['admin','superadmin'] && request.resource.data.get('approvedAt', null) != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','approvedBy','approvedByName','approvedByRole','approvedAt','updatedAt'])) || (isAdmin() && resource.data.status == 'pending' && resource.data.service == 'Mobile Banking' && request.resource.data.get('customerId', null) == resource.data.get('customerId', null) && request.resource.data.get('service', null) == resource.data.get('service', null) && request.resource.data.get('dealerId', null) != resource.data.get('dealerId', null) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dealerId','updatedAt'])));
      allow delete: if false;
    }
    // Sanitized operator queue. Only server-side triggers can create/update/delete these docs.
    match /transactionQueue/{id} {
      allow read: if signedIn() && (
        isAdmin() ||
        (isDealerTier() && resource.data.operatorRole == 'dealer' && resource.data.service == 'Mobile Banking' && (resource.data.get('dealerId', null) == null || resource.data.dealerId == request.auth.uid) && (resource.data.status == 'pending' || resource.data.get('claimedBy', null) == request.auth.uid)) ||
        (isReseller() && resource.data.operatorRole == 'reseller' && resource.data.service in ['Recharge','Internet','Remittance'] && (resource.data.get('resellerId', null) == null || resource.data.resellerId == request.auth.uid) && (resource.data.status == 'pending' || resource.data.get('claimedBy', null) == request.auth.uid))
      );
      allow create, update, delete: if false;
    }
    match /topups/{id} { allow create, update, delete: if false; allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); }
    match /selfTopups/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow create, update, delete: if false; }
    match /pointTransfers/{id} { allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin()); allow create, update, delete: if false; }
    match /businessProfiles/{uid} { allow read: if signedIn() && (uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /recommendationViews/{id} { allow read, write: if false; }
    match /announcements/{id} { allow read: if signedIn() && isAdmin(); allow write: if false; }
    match /advertisements/{id} { allow read: if signedIn(); allow create, update, delete: if isSuperadmin(); }
    match /ad_campaigns/{id} { allow read: if signedIn(); allow create, update, delete: if isSuperadmin(); }
    match /ad_advertisers/{id} { allow read: if signedIn() && isAdmin(); allow create, update, delete: if isSuperadmin(); }
    match /ad_placements/{id} { allow read: if signedIn(); allow create, update, delete: if isSuperadmin(); }
    match /ad_packages/{id} { allow read: if signedIn() && isSuperadmin(); allow create, update, delete: if isSuperadmin(); }
    match /ad_payments/{id} { allow read: if signedIn() && isSuperadmin(); allow create, update, delete: if false; }
    match /ad_daily_stats/{id} { allow read: if signedIn() && isSuperadmin(); allow create, update, delete: if false; }
    match /ad_impressions/{id} { allow create: if (signedIn() && request.resource.data.get('userId', null) == request.auth.uid) || (!signedIn() && !request.resource.data.keys().hasAny(['userId'])); allow read: if signedIn() && (isSuperadmin() || resource.data.get('userId', null) == request.auth.uid); allow update, delete: if false; }
    match /ad_clicks/{id} { allow create: if (signedIn() && request.resource.data.get('userId', null) == request.auth.uid) || (!signedIn() && !request.resource.data.keys().hasAny(['userId'])); allow read: if signedIn() && (isSuperadmin() || resource.data.get('userId', null) == request.auth.uid); allow update, delete: if false; }
    match /supportTickets/{id} {
      allow read: if signedIn() && (isSuperadmin() || resource.data.get('userId', null) == request.auth.uid || resource.data.get('assignedToUid', '') == request.auth.uid || (isAdmin() && resource.data.get('userId', null) != null));
      allow update: if signedIn() && ((isSuperadmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','assignedToUid','assignedToName','assignedToRole','updatedAt']) && request.resource.data.status in ['open','in_progress','resolved']) || (isAdmin() && !isSuperadmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','updatedAt']) && request.resource.data.status in ['open','in_progress','resolved']) || (resource.data.get('assignedToUid', '') == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','updatedAt']) && request.resource.data.status in ['in_progress','resolved']) || (resource.data.get('userId', null) == request.auth.uid && resource.data.status == 'resolved' && request.resource.data.status == 'open' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.keys().hasOnly(['userId','userPhone','userName','userRole','subject','message','status','adminNote','assignedToUid','assignedToName','assignedToRole','createdAt','updatedAt']) && request.resource.data.get('adminNote', '') == '' && request.resource.data.get('assignedToUid', '') == '' && request.resource.data.get('assignedToName', '') == '' && request.resource.data.get('assignedToRole', '') == '';
      allow delete: if false;
    }
  }
}
