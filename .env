# functions/.env — copy this to "functions/.env" (no .example) and fill in real values.
# Read by mailerService.js and smsService.js at Cloud Functions runtime.
# These are TRUE SERVER SECRETS — never move this logic into src/ (client code),
# and never prefix these with EXPO_PUBLIC_.

# --- Email (SMTP) ---
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_USER=info@mysheba.top
SMTP_PASS=Rakib009@
SMTP_FROM=info@mysheba.top

# --- SMS provider ---
SMS_API_URL=https://your-sms-provider.com/api
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=MySheba
