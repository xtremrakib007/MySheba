{
  "name": "mysheba-app",
  "version": "5.4.1.11",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "bump-version": "node scripts/bump-version.js",
    "audit:nav": "node scripts/audit-navigation.js",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "test:rules": "node scripts/test-firestore-rules.mjs"
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-updates": "~0.28.18",
    "expo-linear-gradient": "~14.1.5",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-contacts": "~14.2.6",
    "expo-document-picker": "~13.1.6",
    "expo-image": "~2.4.1",
    "expo-build-properties": "~0.14.8",
    "expo-file-system": "~18.1.11",
    "expo-sharing": "~13.1.5",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-local-authentication": "~16.0.5",
    "expo-status-bar": "~2.2.3",
    "expo-notifications": "~0.31.5",
    "expo-print": "~14.1.4",
    "expo-device": "~7.1.4",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-secure-store": "~14.2.4",
    "expo-crypto": "~14.1.5",
    "crypto-js": "^4.2.0",
    "@rdnf-magiba/expo-face-recognition": "0.1.17",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-webview": "13.13.5",
    "react-native-svg": "15.11.2",
    "react-native-safe-area-context": "5.4.0",
    "firebase": "^12.4.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-firebase/app": "^21.13.0",
    "@react-native-firebase/auth": "^21.13.0",
    "@react-native-firebase/messaging": "^21.13.0",
    "react-native-google-mobile-ads": "14.7.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "react-native-share": "~12.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.0.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "typescript": "~5.8.3",
    "@firebase/rules-unit-testing": "^5.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native",
          "crypto-js",
          "firebase"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "@react-native-firebase/auth": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    },
    "@react-native-firebase/app": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  }
}
