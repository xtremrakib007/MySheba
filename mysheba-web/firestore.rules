rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /accountDeletionRequests/{requestId} {
      // Public website may submit a deletion request, but the client cannot
      // read, update, or delete requests. The document ID must match the
      // requestId field and all accepted fields/values are constrained.
      allow create: if request.resource.data.keys().hasOnly([
        'requestId', 'fullName', 'phone', 'email', 'reason', 'details',
        'language', 'status', 'source', 'page', 'createdAt'
      ])
      && request.resource.id == request.resource.data.requestId
      && request.resource.data.requestId is string
      && request.resource.data.fullName is string
      && request.resource.data.phone is string
      && request.resource.data.email is string
      && request.resource.data.reason is string
      && request.resource.data.details is string
      && request.resource.data.language in ['en', 'bn']
      && request.resource.data.status == 'pending'
      && request.resource.data.source == 'website-account-deletion'
      && request.resource.data.page in ['/delete-account/', '/bn/delete-account/']
      && request.resource.data.reason in ['', 'Not using MySheba anymore', 'Privacy concern', 'Duplicate account', 'Other', 'আর MySheba ব্যবহার করছি না', 'গোপনীয়তা সংক্রান্ত উদ্বেগ', 'ডুপ্লিকেট অ্যাকাউন্ট', 'অন্যান্য']
      && request.resource.data.fullName.size() >= 2
      && request.resource.data.fullName.size() <= 120
      && request.resource.data.phone.size() >= 5
      && request.resource.data.phone.size() <= 40
      && request.resource.data.email.size() <= 160
      && request.resource.data.reason.size() <= 120
      && request.resource.data.details.size() <= 2000
      && request.resource.data.createdAt is timestamp
      && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
