# Native KYC face capture does not require a third-party KYC provider.
# Keep production biometric matching/liveness configuration in secure server
# configuration only after the biometric engine has been selected and tested.

# ---- Outbound email (required) ----
# Read at runtime by functions/mailerService.js, which every email path goes
# through: sign-up email verification, password reset, device verification
# and account merge. Firebase reads functions/.env at DEPLOY time and bakes
# the values into the deployed functions, so this file must exist on the
# machine you deploy from - adding it afterwards needs another deploy.
# Without SMTP_HOST, SMTP_USER and SMTP_PASS those flows fail at runtime with
# "Verification email service is not configured."
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=
# Optional - defaults to SMTP_USER when unset.
SMTP_FROM=MySheba <no-reply@example.com>

# Fixed outgoing IP for IIMMPACT purchases (see functions/egress.js). Leave
# empty until the Serverless VPC Access connector and Cloud NAT exist.
IIMMPACT_VPC_CONNECTOR=

# Fixed-IP proxy for every IIMMPACT call (see functions/iimmpactProxy.js).
# IIMMPACT refuses topup from US IPs and whitelists one fixed IP: run a
# CONNECT proxy (tinyproxy) on a Singapore/Malaysia VM and set, e.g.
#   IIMMPACT_PROXY_URL=http://mysheba:<password>@<vm-ip>:8888
IIMMPACT_PROXY_URL=
