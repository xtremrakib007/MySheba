# Copy this file to: android/keystore.properties  (after running expo prebuild)
# Fill in your actual keystore path + passwords. This file is gitignored —
# never commit it, and never put these values directly into build.gradle.

storeFile=../../my-release-key.jks
storePassword=your-store-password
keyAlias=my-key-alias
keyPassword=your-key-password
