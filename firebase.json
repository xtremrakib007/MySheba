{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "functions-gamebot",
      "codebase": "gamebot",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "myshebas",
      "public": "mysheba-web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!.well-known/**"
      ]
    },
    {
      "target": "admin-web",
      "public": "admin-web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!.well-known/**"
      ]
    }
  ]
}
